# Copy this file to .env and fill in your Supabase project details.
# These variables are read at build time by Create React App (prefix REACT_APP_ is required).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Optional: Used for email redirect in auth flows if added in the future
REACT_APP_SITE_URL=http://localhost:3000
